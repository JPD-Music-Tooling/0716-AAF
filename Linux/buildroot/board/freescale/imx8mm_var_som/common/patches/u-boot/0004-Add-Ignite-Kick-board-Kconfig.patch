From 37fe4b5215f15967b393dd510b61c65f8bb9e61a Mon Sep 17 00:00:00 2001
From: MUSIC Tribe
Date: Thu, 29 Feb 2024 15:29:51 +0530
Subject: [PATCH 1/2] Add Ignite/Kick  board Kconfig

Signed-off-by: MUSIC Tribe
---
 Kconfig                                       |  12 ++
 .../imx8mm_var_dart/imx8mm_var_dart.c         |  19 ++-
 include/configs/imx8mm_var_dart.h             | 148 +++++++++++++++++-
 3 files changed, 173 insertions(+), 6 deletions(-)

diff --git a/Kconfig b/Kconfig
index 5f24c803..d8563996 100644
--- a/Kconfig
+++ b/Kconfig
@@ -617,6 +617,18 @@ config ARCH_FIXUP_FDT_MEMORY
 	  used for booting OS with different memory setup where the part of
 	  the memory location should be used for different purpose.
 
+config BOARD_IGNITE
+	bool "Enabled Board Ignite configuration"
+	default n
+	help
+	    Enabled Board Ignite configuration
+
+config BOARD_KICK
+	bool "Enabled Board Kick configuration"
+	default n
+	help
+	    Enabled Board Kick configuration
+
 endmenu		# Boot images
 
 source "api/Kconfig"
diff --git a/board/variscite/imx8mm_var_dart/imx8mm_var_dart.c b/board/variscite/imx8mm_var_dart/imx8mm_var_dart.c
index 42ab73ed..9665e9bc 100644
--- a/board/variscite/imx8mm_var_dart/imx8mm_var_dart.c
+++ b/board/variscite/imx8mm_var_dart/imx8mm_var_dart.c
@@ -27,9 +27,15 @@ extern int var_setup_mac(struct var_eeprom *eeprom);
 #define GPIO_PAD_CTRL	(PAD_CTL_DSE6 | PAD_CTL_FSEL1 | PAD_CTL_PUE | PAD_CTL_PE)
 
 #define TFT_GPIO         IMX_GPIO_NR(4, 11)
-#define CV_GPIO          IMX_GPIO_NR(1, 00)
-#define SDCARD_RESET    IMX_GPIO_NR(2, 19)
-#define EN_PWR_ON       IMX_GPIO_NR(4, 5)
+
+#if CONFIG_BOARD_IGNITE
+#define CV_GPIO		IMX_GPIO_NR(4, 15)
+#define USB_HUB_PWR_ON	IMX_GPIO_NR(1, 8)
+#else
+#define CV_GPIO		IMX_GPIO_NR(1, 00)
+#define SDCARD_RESET	IMX_GPIO_NR(2, 19)
+#define EN_PWR_ON	IMX_GPIO_NR(4, 5)
+#endif
 
 #ifdef CONFIG_SPL_BUILD
 #define ID_GPIO 	 IMX_GPIO_NR(2, 11)
@@ -252,11 +258,16 @@ int board_late_init(void)
         gpio_request(CV_GPIO, "board_cvGate");
         gpio_direction_output(TFT_GPIO, 0);
         gpio_direction_output(CV_GPIO, 1);
+
+#if CONFIG_BOARD_IGNITE
+	gpio_request(USB_HUB_PWR_ON, "usb_host_enable");
+	gpio_direction_output(USB_HUB_PWR_ON, 1);
+#else
         gpio_request(SDCARD_RESET, "sdcard_reset");
         gpio_request(EN_PWR_ON, "5v_enable");
 	gpio_direction_output(SDCARD_RESET, 1);
         gpio_direction_output(EN_PWR_ON, 1);
-
+#endif
 	burn_emmc_image();
 	return 0;
 }
diff --git a/include/configs/imx8mm_var_dart.h b/include/configs/imx8mm_var_dart.h
index fc368b8b..62e99e3b 100644
--- a/include/configs/imx8mm_var_dart.h
+++ b/include/configs/imx8mm_var_dart.h
@@ -62,7 +62,150 @@
 	"sd_dev=1\0" \
 
 /* Initial environment variables */
+#if CONFIG_BOARD_IGNITE
 #define CONFIG_EXTRA_ENV_SETTINGS		\
+	CONFIG_MFG_ENV_SETTINGS \
+	"bootdir=/\0"	\
+	"emmc_boot=0\0"	\
+	"script=boot.scr\0" \
+	"image=Image.gz\0" \
+	"console=undefined\0" \
+	"img_addr=0x42000000\0"			\
+	"fdt_addr=0x43000000\0"			\
+	"fdt_high=0xffffffffffffffff\0"		\
+	"boot_fdt=try\0" \
+	"ip_dyn=yes\0" \
+	"fdt_file=imx8mm-var-som-ignite.dtb\0" \
+	"mmcdev="__stringify(CONFIG_SYS_MMC_ENV_DEV)"\0" \
+	"mmcblk=1\0" \
+	"mmcautodetect=yes\0" \
+	"mmcpart=1\0" \
+	"m4_addr=0x7e0000\0" \
+	"m4_bin=hello_world.bin\0" \
+	"use_m4=no\0" \
+	"loadm4bin=load mmc ${mmcdev}:${mmcpart} ${loadaddr} ${bootdir}/${m4_bin}; " \
+		"cp.b ${loadaddr} ${m4_addr} ${filesize}\0" \
+	"runm4bin=" \
+		"if test ${m4_addr} = 0x7e0000; then " \
+			"echo Booting M4 from TCM; " \
+		"else " \
+			"echo Booting M4 from DRAM; " \
+			"dcache flush; " \
+		"fi; " \
+		"bootaux ${m4_addr};\0" \
+	"optargs=setenv bootargs ${bootargs} ${kernelargs};\0" \
+	"setconsole=" \
+		"if test $console = undefined; then " \
+			"if test $board_name = VAR-SOM-MX8M-MINI; then " \
+				"setenv console ttymxc3,115200; " \
+			"else " \
+				"setenv console ttymxc0,115200; " \
+			"fi; " \
+		"fi; \0" \
+	"mmcargs=run setconsole; setenv bootargs console=${console} " \
+		"root=/dev/mmcblk${mmcblk}p${mmcpart} rootwait rw ${cma_size}\0 " \
+	"mmcargs0=setenv bootargs console=ttymxc3,115200 earlycon=ec_imx6q,0x30a60000,115200 " \
+		"root=/dev/mmcblk${mmcblk}p2 rootwait ro \0 " \
+	"mmcargs1=setenv bootargs console=ttymxc3,115200 earlycon=ec_imx6q,0x30a60000,115200 " \
+		"root=/dev/mmcblk${mmcblk}p5 rootwait ro \0 " \
+	"loadbootscript=load mmc ${mmcdev}:${mmcpart} ${loadaddr} ${bootdir}/${script};\0" \
+	"bootscript=echo Running bootscript from mmc ...; " \
+		"source\0" \
+	"loadimage=load mmc ${mmcdev}:${mmcpart} ${img_addr} ${bootdir}/${image};" \
+		"unzip ${img_addr} ${loadaddr}\0" \
+	"loadimage0=load mmc ${mmcdev}:1 ${img_addr} ${bootdir}${image};" \
+		"unzip ${img_addr} ${loadaddr}\0" \
+	"loadimage1=load mmc ${mmcdev}:4 ${img_addr} ${bootdir}${image};" \
+		"unzip ${img_addr} ${loadaddr}\0" \
+	"findfdt=" \
+		"if test $fdt_file = undefined; then " \
+			"if test $board_name = VAR-SOM-MX8M-MINI; then " \
+				"if test $carrier_rev = legacy; then " \
+					"setenv fdt_file imx8mm-var-som-symphony-legacy.dtb; " \
+				"else " \
+					"setenv fdt_file imx8mm-var-som-ignite.dtb; " \
+				"fi; " \
+			"else " \
+				"if test $carrier_rev = legacy; then " \
+					"setenv fdt_file imx8mm-var-dart-dt8mcustomboard-legacy.dtb; " \
+				"else " \
+					"setenv fdt_file imx8mm-var-dart-dt8mcustomboard.dtb; " \
+				"fi; " \
+			"fi; " \
+		"fi; \0" \
+	"loadfdt=run findfdt; " \
+		"echo fdt_file=${fdt_file}; " \
+		"load mmc ${mmcdev}:${mmcpart} ${fdt_addr} ${bootdir}/${fdt_file}\0" \
+	"loadfdt0=run findfdt; " \
+		"echo fdt_file=${fdt_file}; " \
+		"load mmc ${mmcdev}:1 ${fdt_addr} ${bootdir}${fdt_file}\0" \
+	"loadfdt1=run findfdt; " \
+		"echo fdt_file=${fdt_file}; " \
+		"load mmc ${mmcdev}:4 ${fdt_addr} ${bootdir}${fdt_file}\0" \
+	"ramsize_check="\
+		"if test $sdram_size -le 512; then " \
+			"setenv cma_size cma=320M; " \
+		"else " \
+			"setenv cma_size cma=640M@1376M; " \
+		"fi;\0" \
+	"mmcboot=echo Booting from mmc ...; " \
+		"run mmcargs${emmc_boot}; " \
+		"run loadimage${emmc_boot}; " \
+		"run optargs; " \
+		"if test ${boot_fdt} = yes || test ${boot_fdt} = try; then " \
+			"if run loadfdt${emmc_boot}; then " \
+				"booti ${loadaddr} - ${fdt_addr}; " \
+			"else " \
+				"echo WARN: Cannot load the DT; " \
+			"fi; " \
+		"else " \
+			"echo wait for boot; " \
+		"fi;\0" \
+	"netargs=run setconsole; setenv bootargs console=${console} " \
+		"root=/dev/nfs ${cma_size} " \
+		"ip=dhcp nfsroot=${serverip}:${nfsroot},v3,tcp\0" \
+	"netboot=echo Booting from net ...; " \
+		"if test ${ip_dyn} = yes; then " \
+			"setenv get_cmd dhcp; " \
+		"else " \
+			"setenv get_cmd tftp; " \
+		"fi; " \
+		"${get_cmd} ${img_addr} ${image}; unzip ${img_addr} ${loadaddr};" \
+		"run netargs; " \
+		"run optargs; " \
+		"if test ${boot_fdt} = yes || test ${boot_fdt} = try; then " \
+			"run findfdt; " \
+			"echo fdt_file=${fdt_file}; " \
+			"if ${get_cmd} ${fdt_addr} ${fdt_file}; then " \
+				"booti ${loadaddr} - ${fdt_addr}; " \
+			"else " \
+				"echo WARN: Cannot load the DT; " \
+			"fi; " \
+		"else " \
+			"booti; " \
+		"fi;\0"
+
+#define CONFIG_BOOTCOMMAND \
+	"run ramsize_check; " \
+	"mmc dev ${mmcdev}; "\
+	"if mmc rescan; then " \
+		"if test ${use_m4} = yes && run loadm4bin; then " \
+			"run runm4bin; " \
+		"fi; " \
+		"if run loadbootscript; then " \
+			"run bootscript; " \
+		"else " \
+			"if run loadimage; then " \
+				"run mmcboot; " \
+			"else " \
+				"run netboot; " \
+			"fi; " \
+		"fi; " \
+	"else " \
+		"booti ${loadaddr} - ${fdt_addr}; " \
+	"fi;"
+#else
+	#define CONFIG_EXTRA_ENV_SETTINGS		\
 	CONFIG_MFG_ENV_SETTINGS \
 	"bootdir=/\0"	\
 	"emmc_boot=0\0"	\
@@ -104,9 +247,9 @@
 	"mmcargs=run setconsole; setenv bootargs console=${console} " \
 		"root=/dev/mmcblk${mmcblk}p${mmcpart} rootwait rw ${cma_size}\0 " \
 	"mmcargs0=setenv bootargs console=ttymxc3,115200 earlycon=ec_imx6q,0x30a60000,115200 " \
-		"root=/dev/mmcblk2p2 rootwait ro \0 " \
+		"root=/dev/mmcblk${mmcblk}p2 rootwait ro \0 " \
 	"mmcargs1=setenv bootargs console=ttymxc3,115200 earlycon=ec_imx6q,0x30a60000,115200 " \
-		"root=/dev/mmcblk2p5 rootwait ro \0 " \
+		"root=/dev/mmcblk${mmcblk}p5 rootwait ro \0 " \
 	"loadbootscript=load mmc ${mmcdev}:${mmcpart} ${loadaddr} ${bootdir}/${script};\0" \
 	"bootscript=echo Running bootscript from mmc ...; " \
 		"source\0" \
@@ -203,6 +346,7 @@
 	"else " \
 		"booti ${loadaddr} - ${fdt_addr}; " \
 	"fi;"
+#endif
 
 /* Link Definitions */
 #define CONFIG_LOADADDR			0x40480000
-- 
2.17.1

