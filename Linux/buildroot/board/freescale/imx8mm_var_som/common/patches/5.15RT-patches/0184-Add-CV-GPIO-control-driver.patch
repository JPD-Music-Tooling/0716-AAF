From 314979febe460c870fc6a14c66bf217491f2355e Mon Sep 17 00:00:00 2001
From: MUSIC Tribe
Date: Tue, 23 Apr 2024 14:08:56 +0530
Subject: [PATCH] CV GPIO Control

Signed-off-by: MUSIC Tribe
---
 drivers/misc/Kconfig  |   7 ++
 drivers/misc/Makefile |   1 +
 drivers/misc/cvctl.c  | 166 ++++++++++++++++++++++++++++++++++++++++++
 drivers/misc/cvctl.h  |  17 +++++
 4 files changed, 191 insertions(+)
 create mode 100644 drivers/misc/cvctl.c
 create mode 100644 drivers/misc/cvctl.h

diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index 0f5a49fc7..1080f4485 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -470,6 +470,13 @@ config HISI_HIKEY_USB
 	  switching between the dual-role USB-C port and the USB-A host ports
 	  using only one USB controller.
 
+config MISC_IGNITE_CVGPIO
+	tristate "Ignite CV GPIO control"
+	default n
+	help
+	  If you say yes this adds support for controlling the CV & Gate
+	  channel from user space.
+
 source "drivers/misc/c2port/Kconfig"
 source "drivers/misc/eeprom/Kconfig"
 source "drivers/misc/cb710/Kconfig"
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index a086197af..b45e46365 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -59,3 +59,4 @@ obj-$(CONFIG_UACCE)		+= uacce/
 obj-$(CONFIG_XILINX_SDFEC)	+= xilinx_sdfec.o
 obj-$(CONFIG_HISI_HIKEY_USB)	+= hisi_hikey_usb.o
 obj-$(CONFIG_HI6421V600_IRQ)	+= hi6421v600-irq.o
+obj-$(CONFIG_MISC_IGNITE_CVGPIO) += cvctl.o
diff --git a/drivers/misc/cvctl.c b/drivers/misc/cvctl.c
new file mode 100644
index 000000000..2389586e0
--- /dev/null
+++ b/drivers/misc/cvctl.c
@@ -0,0 +1,166 @@
+#include "cvctl.h"
+
+#define CV_MUX_S0_GPIO 117
+#define CV_MUX_S1_GPIO 97
+#define CV_MUXA_EN_GPIO 98
+#define CV_MUXB_EN_GPIO 99
+
+#define CV_CHANNEL_1_5 (1 << 0)	// Channel 1 & 5 represented by bit 0, S0
+#define CV_CHANNEL_2_6 (1 << 1)	// Channel 2 & 6 represented by bit 1, S1
+#define CV_CHANNEL_3_7 (1 << 2)	// Channel 3 & 7 represented by bit 2, MUXB
+#define CV_CHANNEL_4_8 (1 << 3)	// Channel 4 & 8 represented by bit 3, MUXA
+
+static int gpio_state = 0;
+
+static void
+cvctl_set_channel (int state, int channel_num)
+{
+  state ? (gpio_state |= (1 << channel_num)) : (gpio_state &=
+						~(1 << (channel_num)));
+  gpio_set_value (CV_MUX_S0_GPIO, CV_CHANNEL_1_5 | gpio_state);
+  gpio_set_value (CV_MUX_S1_GPIO, CV_CHANNEL_2_6 | gpio_state);
+  gpio_set_value (CV_MUXB_EN_GPIO, CV_CHANNEL_3_7 | gpio_state);
+  gpio_set_value (CV_MUXA_EN_GPIO, CV_CHANNEL_4_8 | gpio_state);
+}
+
+static long
+cvctl_misc_ioctl (struct file *file, unsigned int cmd, unsigned long arg)
+{
+  int ret = 0;
+  int channel = 0;
+
+  switch (cmd)
+    {
+    case CV_IOCTL_GET_CHANNELS:
+      printk (KERN_INFO "Received ioctl command: %u\n", cmd);
+      ret = copy_to_user ((int *) arg, &gpio_state, sizeof (int));
+      if (ret)
+	{
+	  printk (KERN_ERR "Failed to copy data to user\n");
+	  return -EFAULT;
+	}
+      break;
+    case CV_IOCTL_ENABLE_CHANNEL:
+      printk (KERN_INFO "Received ioctl command: %u\n", cmd);
+      ret = copy_from_user (&channel, (int *) arg, sizeof (int));
+      if (ret)
+	{
+	  printk (KERN_ERR "Failed to copy data from user\n");
+	  return -EFAULT;
+	}
+      cvctl_set_channel (true, channel);
+      break;
+    case CV_IOCTL_DISABLE_CHANNEL:
+      printk (KERN_INFO "Received ioctl command: %u\n", cmd);
+      ret = copy_from_user (&channel, (int *) arg, sizeof (int));
+      if (ret)
+	{
+	  printk (KERN_ERR "Failed to copy data from user\n");
+	  return -EFAULT;
+	}
+      cvctl_set_channel (false, channel);
+      break;
+    default:
+      return -ENOTTY;
+    }
+  return ret;
+}
+
+static const struct file_operations cvctl_misc_fops = {
+  .owner = THIS_MODULE,
+  .unlocked_ioctl = cvctl_misc_ioctl,
+};
+
+static struct miscdevice cvctl_misc_device = {
+  .minor = MISC_DYNAMIC_MINOR,
+  .name = "cvctl_misc",
+  .fops = &cvctl_misc_fops,
+};
+
+static int __init
+cvctl_misc_init (void)
+{
+  int ret;
+
+  printk (KERN_ERR "CVCTL misc driver probe\n");
+  ret = misc_register (&cvctl_misc_device);
+  if (ret)
+    {
+      pr_err ("Failed to register CVCTL misc device\n");
+      return ret;
+    }
+
+  ret = gpio_request (CV_MUX_S0_GPIO, "cvctl_s0_misc");
+  if (ret)
+    goto gpio_s0_fail;
+
+  ret = gpio_request (CV_MUX_S1_GPIO, "cvctl_s1_misc");
+  if (ret)
+    goto gpio_s1_fail;
+
+  ret = gpio_request (CV_MUXA_EN_GPIO, "cvctl_muxa_misc");
+  if (ret)
+    goto gpio_muxa_fail;
+
+  ret = gpio_request (CV_MUXB_EN_GPIO, "cvctl_muxb_misc");
+  if (ret)
+    goto gpio_muxb_fail;
+
+  ret = gpio_direction_output (CV_MUX_S0_GPIO, gpio_state);
+  if (ret)
+    goto gpio_out_fail;
+
+  ret = gpio_direction_output (CV_MUX_S1_GPIO, gpio_state);
+  if (ret)
+    goto gpio_out_fail;
+
+  ret = gpio_direction_output (CV_MUXA_EN_GPIO, gpio_state);
+  if (ret)
+    goto gpio_out_fail;
+
+  ret = gpio_direction_output (CV_MUXB_EN_GPIO, gpio_state);
+  if (ret)
+    goto gpio_out_fail;
+
+  /* Disable CV OUT: disable MUXA and MUXB */
+  gpio_set_value (CV_MUXA_EN_GPIO, 1);
+  gpio_set_value (CV_MUXB_EN_GPIO, 1);
+
+  pr_info ("CVCTL misc driver initialized\n");
+  return 0;
+
+gpio_out_fail:
+  gpio_free (CV_MUXB_EN_GPIO);
+  pr_err ("Failed to request CV_MUXB_EN_GPIO\n");
+gpio_muxb_fail:
+  gpio_free (CV_MUXA_EN_GPIO);
+  pr_err ("Failed to request CV_MUXA_EN_GPIO\n");
+gpio_muxa_fail:
+  gpio_free (CV_MUX_S1_GPIO);
+  pr_err ("Failed to request CV_MUX_S1_GPIO\n");
+gpio_s1_fail:
+  gpio_free (CV_MUX_S0_GPIO);
+  pr_err ("Failed to request CV_MUX_S0_GPIO\n");
+gpio_s0_fail:
+  misc_deregister (&cvctl_misc_device);
+  pr_err ("Failed to initialize CVCTL misc driver\n");
+  return ret;
+}
+
+static void __exit
+cvctl_misc_exit (void)
+{
+  gpio_free (CV_MUXB_EN_GPIO);
+  gpio_free (CV_MUXA_EN_GPIO);
+  gpio_free (CV_MUX_S1_GPIO);
+  gpio_free (CV_MUX_S0_GPIO);
+  misc_deregister (&cvctl_misc_device);
+  pr_info ("CVCTL misc driver exited\n");
+}
+
+module_init (cvctl_misc_init);
+module_exit (cvctl_misc_exit);
+
+MODULE_LICENSE ("GPL");
+MODULE_AUTHOR ("MUSIC Tribe");
+MODULE_DESCRIPTION ("CV output control via GPIO driver ");
diff --git a/drivers/misc/cvctl.h b/drivers/misc/cvctl.h
new file mode 100644
index 000000000..e78669a07
--- /dev/null
+++ b/drivers/misc/cvctl.h
@@ -0,0 +1,17 @@
+#ifndef CV_IOCTL_H
+#define CV_IOCTL_H
+#endif
+
+#include <linux/ioctl.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/fs.h>
+#include <linux/miscdevice.h>
+#include <linux/gpio.h>
+#include <linux/platform_device.h>
+
+#define CV_IOCTL_MAGIC 'M'
+
+#define CV_IOCTL_GET_CHANNELS _IOR(CV_IOCTL_MAGIC, 1, int)
+#define CV_IOCTL_ENABLE_CHANNEL _IOW(CV_IOCTL_MAGIC, 2, int)
+#define CV_IOCTL_DISABLE_CHANNEL _IOW(CV_IOCTL_MAGIC, 3, int)
-- 
2.17.1

