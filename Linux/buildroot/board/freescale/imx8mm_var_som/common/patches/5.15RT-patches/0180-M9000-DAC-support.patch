+                                vactive = <600>;          /* tried 800 & 768 as well .. 600 works.. */
+                                hback-porch = <40>;
+                                hfront-porch = <40>;
+                                vback-porch = <29>;
+                                vfront-porch = <13>;
+                                hsync-len = <48>;
