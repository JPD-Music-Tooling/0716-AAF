software =
{	version= "0.1"
	description= "Fw Update"
	Ignite = {
                hardware-compatibility: [ "0.0.1" ];

		files: (
			{
				filename = "rootfs.tar.gz";
				device = "/dev/update";
				type= "archive";
				filesystem = "ext4";
				path = "/";
				compressed= true;
			},
			{
				filename = "kernel.tar.gz";
				device = "/dev/kernel";
				type= "archive";
				filesystem = "vfat";
				path = "/";
				compressed= true;
			},
			{
				filename = "appfs.tar.gz";
				device = "/dev/app";
				type= "archive";
				filesystem = "ext4";
				path = "/";
				compressed= true;
			},
			{
				filename = "data.tar.gz";
				device = "/dev/data";
				type= "archive";
				filesystem = "ext4";
				path = "/";
				compressed= true;
			}
		);
		scripts: (
			{
				filename = "preinstall.sh";
				type = "shellscript";
			}
		);


	};
};

